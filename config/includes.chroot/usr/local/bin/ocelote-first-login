#!/bin/sh
# Se ejecuta en el primer inicio de sesion: pone el fondo de pantalla
MARK="$HOME/.config/ocelote/.setup-done"
[ -f "$MARK" ] && exit 0
mkdir -p "$(dirname "$MARK")"
WALL=/usr/share/backgrounds/ocelote/aurora.png
sleep 5
props=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$')
if [ -n "$props" ]; then
  for p in $props; do xfconf-query -c xfce4-desktop -p "$p" -s "$WALL"; done
else
  for m in monitorVirtual-1 monitorVGA-1 monitor0; do
    xfconf-query -c xfce4-desktop -p "/backdrop/screen0/$m/workspace0/last-image" -n -t string -s "$WALL"
  done
fi
touch "$MARK"

# Acceso directo para instalar (solo existe en el modo live)
if grep -q 'boot=live' /proc/cmdline && command -v calamares >/dev/null 2>&1; then
  mkdir -p "$HOME/Desktop"
  F="$HOME/Desktop/Instalar-Ocelote.desktop"
  cat > "$F" <<'EOT'
[Desktop Entry]
Type=Application
Name=Instalar Ocelote OS
Comment=Instalar en el disco de la maquina virtual
Exec=sudo -E calamares
Icon=system-software-install
Terminal=false
EOT
  chmod +x "$F"
  gio set "$F" metadata::xfce-exe-checksum "$(sha256sum "$F" | cut -d' ' -f1)" 2>/dev/null || true
fi
